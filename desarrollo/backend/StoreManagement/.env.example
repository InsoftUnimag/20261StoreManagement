# ============================================================================
# STOREMANAGEMENT BACKEND - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to Git - it's already in .gitignore
# ============================================================================

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=8080

# ============================================================================
# DATABASE - POSTGRESQL
# ============================================================================
DB_URL=jdbc:postgresql://localhost:5433/store_management
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Database connection pool settings
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONN_TIMEOUT=30000

# ============================================================================
# RABBITMQ MESSAGE BROKER
# ============================================================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=K8QKjD*Da~2MfxM

# ============================================================================
# JWT AUTHENTICATION (CRITICAL - CHANGE IN PRODUCTION)
# ============================================================================
# Generate a strong secret key for production:
# 1. Use OpenSSL: openssl rand -base64 64
# 2. Or use online generator: https://www.allkeysgenerator.com/
# Minimum 64 characters recommended for HS256
JWT_SECRET=dev-secret-key-change-in-production

# JWT token expiration in milliseconds (default: 24 hours = 86400000 ms)
JWT_EXPIRATION=86400000

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================
# Module Usuarios (Users/Persons Module)
MODULO_USUARIOS_URL=http://localhost:8081
MODULO_USUARIOS_CONNECT_TIMEOUT=2000
MODULO_USUARIOS_READ_TIMEOUT=5000

# ============================================================================
# CORS - ALLOWED ORIGINS
# ============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200

# ============================================================================
# OPENAPI / SWAGGER DOCUMENTATION
# ============================================================================
SWAGGER_ENABLED=true
OPENAPI_SERVER_URL=http://localhost:8080
OPENAPI_SERVER_DESC=Local Development Server
OPENAPI_PROD_URL=https://api.storemanagement.com
OPENAPI_PROD_DESC=Production Server

# ============================================================================
# ASYNC CONFIGURATION
# ============================================================================
ASYNC_CORE_POOL=2
ASYNC_MAX_POOL=5
ASYNC_QUEUE_CAPACITY=100

# ============================================================================
# DOCKER COMPOSE
# ============================================================================
DOCKER_COMPOSE_ENABLED=true

# ============================================================================
# JPA / HIBERNATE
# ============================================================================
JPA_SHOW_SQL=false

# ============================================================================
# DEVELOPMENT ONLY - MOCK LOGIN
# ============================================================================
# El mock-login siempre está disponible con estos usuarios de prueba:
#   - CC: 11111111 → Role: OPERARIO_PICKING
#   - CC: 22222222 → Role: OPERARIO_DESPACHO
#   - CC: 33333333 → Role: SUPERVISOR_INVENTARIO
#   - CC: 44444444 → Role: ASESOR_COMERCIAL
#   - CC: 55555555 → Role: OPERARIO_RECEPCION
# Endpoint: POST /api/v1/auth/mock-login

# ============================================================================
# NOTIFICATION URLS (External Services)
# ============================================================================
NOTIFICACIONES_SUPERVISOR_URL=
NOTIFICACIONES_EXCEPCIONES_URL=
NOTIFICACIONES_TRANSPORTE_URL=

# ============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ============================================================================
# Before deploying to production, ensure:
#
# 1. ✓ Generate a strong JWT_SECRET (minimum 64 characters)
# 2. ✓ Use STRONG passwords for DB_PASSWORD and RABBITMQ_PASSWORD
# 3. ✓ Set APP_MOCK_LOGIN_ENABLED=false
# 4. ✓ Configure correct CORS_ORIGINS (no localhost)
# 5. ✓ Set OPENAPI_SERVER_URL to your production domain
# 6. ✓ Update MODULO_USUARIOS_URL to production endpoint
# 7. ✓ Enable HTTPS for all external service URLs
# 8. ✓ Configure proper monitoring and logging
# 9. ✓ Use environment-specific secrets management (AWS Secrets Manager, etc.)
# 10. ✓ Test the application thoroughly in a staging environment
#
# ============================================================================
